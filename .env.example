# AOS Hive Brain — environment template (PUBLIC)
# Copy to .env and fill locally. Never commit real secrets.

# Toggle auth entirely off for local demos without OAuth:
# VITE_AUTH_ENABLED=false

# Deployed Better Auth + Postgres
# BETTER_AUTH_URL=https://your-deploy-host.example
# BETTER_AUTH_SECRET=generate-a-long-random-string
# DATABASE_URL=postgres://user:pass@host:5432/db

# Federated auth via broker (per-app client — never commit values)
# GROK_AUTH_ISSUER=https://auth.grok.me
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=

# Optional local preview client (empty in public tree by design)
# GROK_PREVIEW_CLIENT_ID=
# GROK_PREVIEW_CLIENT_SECRET=
